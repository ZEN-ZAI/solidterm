{
  "_resolution_order": "managed > local > project > user (per raw/cc-docs-c-settings-hosted.md)",
  "_array_semantics": "allow/deny concatenated + deduped across scopes",
  "_scalar_semantics": "later override earlier",
  "_deny_supremacy": "deny at any level wins over allow at any level",
  "model": "claude-haiku-4-5-20251001",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(cargo *)",
      "Bash(git status:*)",
      "Bash(make *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(*--no-verify*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,
  "env": {
    "RUST_LOG": "nextterm=trace"
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "./scripts/sandbox-check.sh" }] }
    ]
  }
}
