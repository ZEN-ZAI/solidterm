{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push*--no-verify*)",
      "Bash(git commit*--no-verify*)",
      "Bash(rm*-rf*~*)",
      "Bash(rm*-rf*$HOME*)"
    ],
    "allow": [
      "Bash(cargo *)",
      "Bash(xcodebuild *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": []
      }
    ]
  },
  "teammateMode": "auto",
  "respectGitignore": true
}
